#       z does NOT contain an intercept; free parameters 2K + p' (p' = 4).
#   In both variants the mixing weights are lambda_ik = softmax_k(eta_ik) and
#   the response is Binomial(m, p_i) with p_i ~ Bernstein(K, lambda_i).
#
#   For BOTH variants the degree K is selected inside the training set by
#   5-fold cross-validation repeated twice with the validation log-likelihood
#   (BIC and CV-MSE are also recorded). All models are then evaluated on the
#   held-out test set.
# Run: Rscript 07_two_variants_comparison.R
# ============================================================================
source("00_regression_lib.R")
std <- function(v) as.numeric(scale(v))
dat <- read.csv("data/mathexam_data.csv", stringsAsFactors = TRUE)
View(dat)
m <- dat$m[1]; x <- dat$x; n <- length(x)
Z <- cbind(tests = std(dat$tests), genderM = as.numeric(dat$gender == "male"),
study571 = as.numeric(dat$study == "571"), semester = std(dat$semester))
X <- cbind(1, Z)                      # for variant A, logistic and beta-binomial
set.seed(12345)
te <- sample(1:n, floor(0.3 * n)); tr <- setdiff(1:n, te)
X_tr <- X[tr,,drop=FALSE]; X_te <- X[te,,drop=FALSE]
Z_tr <- Z[tr,,drop=FALSE]; Z_te <- Z[te,,drop=FALSE]
x_tr <- x[tr]; x_te <- x[te]
n1 <- length(x_tr); n2 <- length(x_te)
# ---- reference models -----------------------------------------------------
glm_fit <- glm(cbind(x_tr, m - x_tr) ~ Z_tr, family = binomial)
fit_log <- fit_logistic(X_tr, m, x_tr); ll_log <- as.numeric(logLik(glm_fit))
fit_bb  <- fit_bbreg(X_tr, m, x_tr)
# ---- K selection for both variants ---------------------------------------
Kmax <- 10; folds <- 5; reps <- 2
sel <- function(fitfun, D, indep, nstart) {
# returns the CV curve (logLik and MSE) over K
set.seed(6789)
ll <- mse <- matrix(NA, Kmax, folds * reps)
for (K in 1:Kmax) {
col <- 0
for (r in 1:reps) {
foldid <- sample(rep(1:folds, length.out = n1))
for (f in 1:folds) {
col <- col + 1
va <- which(foldid == f); tr2 <- which(foldid != f)
D_tr <- D[tr2, , drop = FALSE]; D_va <- D[va, , drop = FALSE]
fK <- fitfun(D_tr, m, x_tr[tr2], K, nstart = nstart, nindep = indep)
ll[K, col]  <- test_loglik("bernreg", fK, D_va, m, x_tr[va], K)
mse[K, col] <- test_mse("bernreg", fK, D_va, m, x_tr[va], K)
}
}
}
data.frame(K = 1:Kmax, CV_mean_logLik = rowMeans(ll), CV_mean_MSE = rowMeans(mse))
}
cat("selecting K for variant A by CV ...\n")
cvA <- sel(fit_bernregA, X_tr, indep = 3, nstart = 1)
cat("selecting K for variant B by CV ...\n")
View(cvA)
K_A <- cvA$K[which.max(cvA$CV_mean_logLik)]
K_B <- cvB$K[which.max(cvB$CV_mean_logLik)]
cvB <- sel(fit_bernreg,  Z_tr, indep = 4, nstart = 4)
K_B <- cvB$K[which.max(cvB$CV_mean_logLik)]
# BIC curves on the training set
bicA <- bernA_fit_bic(X_tr, m, x_tr, Kmax, nindep = 4)$curve
bicB <- bernreg_fit_bic(Z_tr, m, x_tr, Kmax, nstart = 4, nindep = 4)$curve
ksel <- data.frame(K = 1:Kmax,
A_train_ll = bicA$train_ll, A_BIC = bicA$BIC,
A_CV_logLik = cvA$CV_mean_logLik, A_CV_MSE = cvA$CV_mean_MSE,
B_train_ll = bicB$train_ll, B_BIC = bicB$BIC,
B_CV_logLik = cvB$CV_mean_logLik, B_CV_MSE = cvB$CV_mean_MSE)
write.csv(ksel, "results/me3_k_selection.csv", row.names = FALSE)
ksel
View(fit_bernreg)
# ---- final fits at the CV-selected degrees -------------------------------
fit_A <- fit_bernregA(X_tr, m, x_tr, K_A, nindep = 20)
fit_B <- fit_bernreg(Z_tr, m, x_tr, K_B, nstart = 12, nindep = 60)
View(fit_B)
View(fit_A)
View(fit_bernreg)
View(fit_bernregA)
cat(sprintf("K (CV): A = %d, B = %d\n", K_A, K_B))
# ---- parameter tables -----------------------------------------------------
BA <- fit_A$pred(X_tr)$B                       # p x K
tabA <- data.frame(term = paste0("beta_", rep(colnames(X), K_A), "_k",
rep(1:K_A, each = ncol(X))),
estimate = as.numeric(BA))
prB <- fit_B$pred(Z_tr)
tabB <- data.frame(term = c(paste0("phi_", 0:K_B), paste0("gamma_", 0:K_B),
paste0("beta_", colnames(Z))),
estimate = c(prB$phi, prB$gam, prB$beta))
tabA
tabB
# ---- training and test criteria ------------------------------------------
ev <- function(md, fit, D, K = NULL) c(
test_logLik = test_loglik(md, fit, D, m, x_te, K),
test_MAE    = test_mae(md, fit, D, m, x_te, K),
test_MSE    = test_mse(md, fit, D, m, x_te, K))
rows <- list(
Logistic  = list(npar = length(coef(glm_fit)), K = NA, ll = ll_log,
te = ev("logistic", fit_log, X_te)),
BetaBinom = list(npar = fit_bb$npar, K = NA, ll = fit_bb$ll,
te = ev("bbreg", fit_bb, X_te)),
BernA     = list(npar = fit_A$npar, K = K_A, ll = fit_A$ll,
te = ev("bernreg", fit_A, X_te)),
BernB     = list(npar = fit_B$npar, K = K_B, ll = fit_B$ll,
te = ev("bernreg", fit_B, Z_te)))
train_tab <- do.call(rbind, lapply(names(rows), function(nm) {
r <- rows[[nm]]
data.frame(Model = nm, npar = r$npar, K = r$K, train_logLik = r$ll,
train_AIC = 2*r$npar - 2*r$ll, train_BIC = r$npar*log(n1) - 2*r$ll)
}))
test_tab <- do.call(rbind, lapply(names(rows), function(nm) {
r <- rows[[nm]]
data.frame(Model = nm, npar = r$npar, K = r$K, test_logLik = r$te["test_logLik"],
test_MAE = r$te["test_MAE"], test_MSE = r$te["test_MSE"])
}))
test_tab$test_AIC <- 2*test_tab$npar - 2*test_tab$test_logLik
test_tab$test_BIC <- test_tab$npar*log(n2) - 2*test_tab$test_logLik
train_tab
test_tab
cat("\n===== training criteria =====\n"); print(train_tab, row.names = FALSE, digits = 4)
cat("\n===== test criteria =====\n");     print(test_tab,  row.names = FALSE, digits = 4)
cat("\n===== parameters: variant A (beta_k) =====\n"); print(tabA, row.names = FALSE, digits = 4)
cat("\n===== parameters: variant B (phi, gamma, beta) =====\n"); print(tabB, row.names = FALSE, digits = 4)
cat("\nSaved results/me3_*.csv\n")
fit_bb$theta
View(fit_log)
glm_fit$coefficients
